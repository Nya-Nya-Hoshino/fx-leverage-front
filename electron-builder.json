{
  "appId": "com.fxleveragefront.game",
  "productName": "FX Leverage Front",
  "copyright": "Fictional simulation game. No real money.",
  "electronVersion": "44.9.0",
  "electronDist": "node_modules/electron/dist",
  "directories": {
    "app": "build/desktop-app",
    "output": "release",
    "buildResources": "build/icons"
  },
  "files": [
    "**/*",
    "!node_modules/**"
  ],
  "asar": true,
  "npmRebuild": false,
  "win": {
    "icon": "build/icons/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "杠杆战线 FX Leverage Front",
    "artifactName": "FX-Leverage-Front-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "FX-Leverage-Front-Portable-${version}.${ext}"
  }
}
